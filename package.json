{
  "name": "unlockhertech-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --target es2022 && node scripts/generate-sitemap.mjs",
    "build:local": "vite build --target es2022 && node scripts/generate-sitemap.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "jobs:curate": "node scripts/curate-jobs.mjs --dry-run",
    "jobs:export": "node scripts/curate-jobs.mjs --output=data/vetted-jobs.json",
    "sync:jobs": "tsx scripts/sync-ats-jobs.ts",
    "check:jobs": "tsx scripts/check-job-health.ts",
    "preview": "vite preview",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=22.13.1"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.0",
    "@sanity/client": "^8.2.0",
    "@sanity/image-url": "^2.1.1",
    "@types/prismjs": "^1.26.6",
    "canvas-confetti": "^1.9.4",
    "gray-matter": "^4.0.3",
    "jspdf": "^4.2.1",
    "patch-package": "^8.0.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.2",
    "sanity": "^6.10.1",
    "styled-components": "^6.5.3"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "js-cookie": "^3.0.6",
    "lodash": "^4.17.21",
    "js-yaml": "^4.2.0",
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
