# Sanity CMS Environment Variables
# Copy this file to .env and fill in your Sanity project details (https://sanity.io/manage)

VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2026-07-31

# Feature Flags
VITE_ENABLE_BLOG=true
VITE_ENABLE_EVENTS=true
VITE_ENABLE_RESOURCES=true
VITE_ENABLE_ASSESSMENT=true
VITE_ENABLE_GET_INVOLVED=true
VITE_ENABLE_JOBS=true